{
  "name": "rcc-admin-discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord administration assistant for the RCC project.",
  "engines": { "node": ">=24.17.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot.mjs",
    "register": "node --env-file-if-exists=.env register-commands.mjs",
    "check": "node --check src/bot.mjs && node --check register-commands.mjs"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "openai": "^7.43.0"
  }
}