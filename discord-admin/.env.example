# Discord Developer Portal > General Information
DISCORD_APPLICATION_ID=YOUR_APPLICATION_ID
DISCORD_PUBLIC_KEY=YOUR_DISCORD_PUBLIC_KEY

# Discord Developer Portal > Bot > Reset Token (keep this secret)
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN

# OpenAI API key (API billing is separate from a ChatGPT subscription)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.5

# Strongly recommended: restrict this service to your own Discord server.
# Enable Developer Mode in Discord, right-click your server, and copy its ID.
DISCORD_GUILD_ID=YOUR_SERVER_ID

# Optional: used only to make command registration happen automatically at startup.
REGISTER_COMMANDS_ON_START=true

PORT=3000
