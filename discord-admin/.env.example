# Discord Developer Portal > General Information
DISCORD_APPLICATION_ID=YOUR_APPLICATION_ID
DISCORD_PUBLIC_KEY=YOUR_DISCORD_PUBLIC_KEY

# Discord Developer Portal > Bot > Reset Token (keep this secret)
DISCORD_BOT_TOKEN=YOUR_NEW_BOT_TOKEN

# Netlify AI Gateway supplies Gemini credentials automatically at runtime.
# Current model with function-calling support. Override only with an available model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Restrict this service to your own Discord server.
DISCORD_GUILD_ID=YOUR_SERVER_ID

# Register the /rcc command on startup for the configured server.
REGISTER_COMMANDS_ON_START=true

PORT=3000

# Optional: ID of the channel where approved RCC announcements are published.
DISCORD_ANNOUNCEMENT_CHANNEL_ID=

# Private endpoint used by Cloudflare Pages after a verified Ko-fi payment or Discord link.
# Set the same random secret in the VIP caller and this Netlify service.
RCC_VIP_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Discord role ID for RCC Supporter (the bot must be able to manage this role).
DISCORD_VIP_ROLE_ID=YOUR_VIP_ROLE_ID
